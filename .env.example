# StoryMaker + AgentPM Environment Configuration
# Copy this file to .env.local and add your real API keys

# === Database & Infrastructure ===
POSTGRES_DSN=postgresql://story:story@localhost:5432/storymaker
DATABASE_URL=postgresql://story:story@localhost:5432/storymaker
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=storymaker
S3_ACCESS_KEY=story
S3_SECRET_KEY=storysecret
OAUTH_ISSUER=http://localhost:8000

# === Service URLs (REQUIRED for orchestration) ===
NARRATIVE_BASE=http://127.0.0.1:8001
WORLDCORE_BASE=http://127.0.0.1:8000
SCREENPLAY_BASE=http://127.0.0.1:8002
MEDIA_BASE=http://127.0.0.1:8003
INTERACT_BASE=http://127.0.0.1:8004

# === Groq Creative Generation (REQUIRED) ===
# Get your API key from: https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# === LM Studio Embeddings & Reranking ===
OPENAI_API_BASE=http://127.0.0.1:1234/v1
OPENAI_API_KEY=lm-studio
CHAT_MODEL=qwen/qwen3-4b-2507
EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b
EMBEDDING_DIMS=1024

# === AgentPM Configuration ===
MOCK_LMS=0
DISABLE_MOCKS=1