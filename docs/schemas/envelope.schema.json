{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ok", "error"]
    },
    "data": {
      "type": ["object", "null"]
    },
    "error": {
      "type": ["object", "null"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"}
      },
      "required": ["code", "message"]
    },
    "meta": {
      "type": "object",
      "properties": {
        "run_id": {"type": "string"},
        "timestamp": {"type": "string"},
        "source": {"type": "string"},
        "schema_version": {"type": "string"}
      },
      "required": ["run_id", "timestamp", "source", "schema_version"]
    }
  },
  "required": ["status", "data", "error", "meta"]
}